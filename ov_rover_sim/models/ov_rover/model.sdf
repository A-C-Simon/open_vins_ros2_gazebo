          <script>
            <name>Gazebo/DarkGrey</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>
      <visual name='base_footprint_fixed_joint_lump__cam0_link_visual_1'>
        <pose>0.22 0.055 0.28 0 -0 0</pose>
        <geometry>
          <box>
            <size>0.04 0.04 0.04</size>
          </box>
        </geometry>
      </visual>
      <visual name='base_footprint_fixed_joint_lump__cam1_link_visual_2'>
        <pose>0.22 -0.055 0.28 0 -0 0</pose>
        <geometry>
          <box>
            <size>0.04 0.04 0.04</size>
          </box>
        </geometry>
      </visual>
      <sensor name='cam0_sensor' type='camera'>
        <always_on>1</always_on>
        <update_rate>20</update_rate>
        <camera name='cam0'>
          <horizontal_fov>1.57</horizontal_fov>
          <image>
            <width>640</width>
            <height>400</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>50</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.0</stddev>
          </noise>
        </camera>
        <plugin name='cam0_driver' filename='libgazebo_ros_camera.so'>
          <camera_name>cam0</camera_name>
          <frame_name>cam0_link</frame_name>
        </plugin>
        <pose>0.22 0.055 0.28 0 -0 0</pose>
      </sensor>
      <sensor name='cam1_sensor' type='camera'>
        <always_on>1</always_on>
        <update_rate>20</update_rate>
        <camera name='cam1'>
          <horizontal_fov>1.57</horizontal_fov>
          <image>
            <width>640</width>
            <height>400</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>50</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.0</stddev>
