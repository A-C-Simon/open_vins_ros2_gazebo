<?xml version="1.0"?>
<sdf version="1.6">
  <!-- Minimal 4-wheel diff-drive rover for OpenVINS testing.
       Primitives only (no meshes) to stay light.
       Publishes: /cmd_vel -> /odom, /imu0, /cam0/image_raw, /cam1/image_raw
       Drive: ONE libgazebo_ros_diff_drive with num_wheel_pairs=2 driving
       all four wheels (two plugin instances fight; one instance works).
       Wheel link frames stay identity; only cylinder geometries are rolled. -->
  <model name="ov_rover">
    <pose>0 0 0.1 0 0 0</pose>
    <static>false</static>

    <link name="base_footprint"/>

    <link name="base_link">
      <pose>0 0 0.16 0 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.03</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.03</iyy><iyz>0</iyz><izz>0.04</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry><box><size>0.40 0.26 0.15</size></box></geometry>
      </collision>
      <visual name="base_visual">
        <geometry><box><size>0.40 0.26 0.15</size></box></geometry>
        <material><script><name>Gazebo/DarkGrey</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
      </visual>
    </link>

    <!-- 4 driven wheels, ONE diff_drive plugin with num_wheel_pairs=2.
         Link frames stay identity (parent-aligned); only the cylinder
         geometries carry the 90-deg roll so axle = parent Y. -->
    <link name="wheel_rear_left_link">
      <pose>-0.12 0.22 0.08 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia><ixx>0.00035</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00064</iyy><iyz>0</iyz><izz>0.00035</izz></inertia>
      </inertial>
      <collision name="c">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction><contact><ode><kp>1e+6</kp><kd>100</kd></ode></contact></surface>
      </collision>
      <visual name="v">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        <material><script><name>Gazebo/Black</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
      </visual>
    </link>
    <link name="wheel_rear_right_link">
      <pose>-0.12 -0.22 0.08 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia><ixx>0.00035</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00064</iyy><iyz>0</iyz><izz>0.00035</izz></inertia>
      </inertial>
      <collision name="c">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction><contact><ode><kp>1e+6</kp><kd>100</kd></ode></contact></surface>
      </collision>
      <visual name="v">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        <material><script><name>Gazebo/Black</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
      </visual>
    </link>
    <link name="wheel_front_left_link">
      <pose>0.12 0.22 0.08 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia><ixx>0.00035</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00064</iyy><iyz>0</iyz><izz>0.00035</izz></inertia>
      </inertial>
      <collision name="c">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction><contact><ode><kp>1e+6</kp><kd>100</kd></ode></contact></surface>
      </collision>
      <visual name="v">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        <material><script><name>Gazebo/Black</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
      </visual>
    </link>
    <link name="wheel_front_right_link">
      <pose>0.12 -0.22 0.08 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia><ixx>0.00035</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00064</iyy><iyz>0</iyz><izz>0.00035</izz></inertia>
      </inertial>
      <collision name="c">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction><contact><ode><kp>1e+6</kp><kd>100</kd></ode></contact></surface>
      </collision>
      <visual name="v">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        <material><script><name>Gazebo/Black</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
      </visual>
    </link>

    <!-- IMU -->
    <link name="imu_link">
      <pose>0 0 0.16 0 0 0</pose>
      <inertial><mass>0.01</mass>
        <inertia><ixx>1e-06</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-06</iyy><iyz>0</iyz><izz>1e-06</izz></inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-04</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-04</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-04</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>2.0e-03</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>2.0e-03</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>2.0e-03</stddev></noise></z>
          </linear_acceleration>
        </imu>
        <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
          <ros><remapping>~/out:=/imu0</remapping></ros>
          <frame_name>imu_link</frame_name>
        </plugin>
      </sensor>
    </link>

    <!-- stereo cameras: baseline 0.11 m, forward looking -->
    <link name="cam0_link">
      <pose>0.22 0.055 0.28 0 0 0</pose>
      <inertial><mass>0.05</mass>
        <inertia><ixx>1e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-05</iyy><iyz>0</iyz><izz>1e-05</izz></inertia>
      </inertial>
      <visual name="v"><geometry><box><size>0.04 0.04 0.04</size></box></geometry>
        <material><script><name>Gazebo/Blue</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
      </visual>
      <sensor name="cam0_sensor" type="camera">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <camera name="cam0">
          <horizontal_fov>1.57</horizontal_fov>
          <image><width>640</width><height>400</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>50</far></clip>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.007</stddev></noise>
        </camera>
        <plugin name="cam0_driver" filename="libgazebo_ros_camera.so">
          <!-- camera_name sets the topic namespace: /cam0/image_raw, /cam0/camera_info -->
          <camera_name>cam0</camera_name>
          <frame_name>cam0_link</frame_name>
        </plugin>
      </sensor>
    </link>

    <link name="cam1_link">
      <pose>0.22 -0.055 0.28 0 0 0</pose>
      <inertial><mass>0.05</mass>
        <inertia><ixx>1e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-05</iyy><iyz>0</iyz><izz>1e-05</izz></inertia>
      </inertial>
      <visual name="v"><geometry><box><size>0.04 0.04 0.04</size></box></geometry>
        <material><script><name>Gazebo/Red</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
      </visual>
      <sensor name="cam1_sensor" type="camera">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <camera name="cam1">
          <horizontal_fov>1.57</horizontal_fov>
          <image><width>640</width><height>400</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>50</far></clip>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.007</stddev></noise>
        </camera>
        <plugin name="cam1_driver" filename="libgazebo_ros_camera.so">
          <!-- camera_name sets the topic namespace: /cam1/image_raw, /cam1/camera_info -->
          <camera_name>cam1</camera_name>
          <frame_name>cam1_link</frame_name>
        </plugin>
      </sensor>
    </link>

    <joint name="base_joint" type="fixed"><parent>base_footprint</parent><child>base_link</child></joint>
    <joint name="wheel_rear_left_joint" type="revolute">
      <parent>base_link</parent><child>wheel_rear_left_link</child>
      <pose>-0.12 0.22 -0.08 0 0 0</pose>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>
    <joint name="wheel_rear_right_joint" type="revolute">
      <parent>base_link</parent><child>wheel_rear_right_link</child>
      <pose>-0.12 -0.22 -0.08 0 0 0</pose>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>
    <joint name="wheel_front_left_joint" type="revolute">
      <parent>base_link</parent><child>wheel_front_left_link</child>
      <pose>0.12 0.22 -0.08 0 0 0</pose>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>
    <joint name="wheel_front_right_joint" type="revolute">
      <parent>base_link</parent><child>wheel_front_right_link</child>
      <pose>0.12 -0.22 -0.08 0 0 0</pose>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>
    <joint name="imu_joint" type="fixed"><parent>base_link</parent><child>imu_link</child></joint>
    <joint name="cam0_joint" type="fixed"><parent>base_link</parent><child>cam0_link</child></joint>
    <joint name="cam1_joint" type="fixed"><parent>base_link</parent><child>cam1_link</child></joint>

    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros><remapping>cmd_vel:=/cmd_vel</remapping><remapping>odom:=/odom</remapping></ros>
      <update_rate>50</update_rate>
      <num_wheel_pairs>2</num_wheel_pairs>
      <left_joint>wheel_front_left_joint</left_joint>
      <left_joint>wheel_rear_left_joint</left_joint>
      <right_joint>wheel_front_right_joint</right_joint>
      <right_joint>wheel_rear_right_joint</right_joint>
      <wheel_separation>0.44</wheel_separation>
      <wheel_separation>0.44</wheel_separation>
      <wheel_diameter>0.16</wheel_diameter>
      <wheel_diameter>0.16</wheel_diameter>
      <max_wheel_torque>30.0</max_wheel_torque>
      <max_wheel_acceleration>8.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>

    <plugin name="joint_state" filename="libgazebo_ros_joint_state_publisher.so">
      <ros><remapping>~/out:=/joint_states</remapping></ros>
      <update_rate>30</update_rate>
      <joint_name>wheel_front_left_joint</joint_name>
      <joint_name>wheel_rear_left_joint</joint_name>
      <joint_name>wheel_front_right_joint</joint_name>
      <joint_name>wheel_rear_right_joint</joint_name>
    </plugin>
  </model>
</sdf>
