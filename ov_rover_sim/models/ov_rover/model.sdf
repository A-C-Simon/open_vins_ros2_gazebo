<sdf version='1.7'>
  <model name='ov_rover'>
    <link name='base_footprint'>
      <inertial>
        <pose>0 0 0.16 0 -0 0</pose>
        <mass>2.5</mass>
        <inertia>
          <ixx>0.04</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.04</iyy>
          <iyz>0</iyz>
          <izz>0.05</izz>
