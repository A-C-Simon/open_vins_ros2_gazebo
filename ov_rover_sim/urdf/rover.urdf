<?xml version="1.0"?>
<!--
  ov_rover: compact 4-wheel diff-drive rover for OpenVINS testing.
  4 driven wheels (libgazebo_ros_diff_drive, num_wheel_pairs=2),
  stereo cameras + IMU. Built URDF-first like the proven reference rig:
  generate the spawned SDF with: gz sdf -p urdf/rover.urdf > ../models/ov_rover/model.sdf
  (robot_state_publisher keeps using this URDF for TF.)
-->
<robot name="ov_rover">
  <material name="grey"><color rgba="0.4 0.4 0.4 1.0"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="blue"><color rgba="0.2 0.2 0.8 1.0"/></material>
  <material name="red"><color rgba="0.8 0.2 0.2 1.0"/></material>

  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0.16" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <mass value="2.5"/>
      <inertia ixx="0.04" ixy="0" ixz="0" iyy="0.04" iyz="0" izz="0.05"/>
      <origin xyz="0 0 0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.40 0.26 0.15"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.40 0.26 0.15"/></geometry>
    </collision>
  </link>

  <!-- wheels: r=0.08, track 0.44, wheelbase 0.24. Link frames identity;
       only cylinder geometries carry the roll into parent Y. -->
  <link name="wheel_rear_left_link">
    <inertial>
      <mass value="0.35"/>
      <inertia ixx="0.00061" ixy="0" ixz="0" iyy="0.00112" iyz="0" izz="0.00061"/>
      <origin xyz="0 0 0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.08" length="0.04"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.08" length="0.04"/></geometry>
    </collision>
  </link>
  <joint name="wheel_rear_left_joint" type="continuous">
    <parent link="base_link"/><child link="wheel_rear_left_link"/>
    <origin xyz="-0.12 0.22 -0.08" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_rear_right_link">
    <inertial>
      <mass value="0.35"/>
      <inertia ixx="0.00061" ixy="0" ixz="0" iyy="0.00112" iyz="0" izz="0.00061"/>
      <origin xyz="0 0 0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.08" length="0.04"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.08" length="0.04"/></geometry>
    </collision>
  </link>
  <joint name="wheel_rear_right_joint" type="continuous">
    <parent link="base_link"/><child link="wheel_rear_right_link"/>
    <origin xyz="-0.12 -0.22 -0.08" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_front_left_link">
    <inertial>
      <mass value="0.35"/>
      <inertia ixx="0.00061" ixy="0" ixz="0" iyy="0.00112" iyz="0" izz="0.00061"/>
      <origin xyz="0 0 0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.08" length="0.04"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.08" length="0.04"/></geometry>
    </collision>
  </link>
  <joint name="wheel_front_left_joint" type="continuous">
    <parent link="base_link"/><child link="wheel_front_left_link"/>
    <origin xyz="0.12 0.22 -0.08" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_front_right_link">
    <inertial>
      <mass value="0.35"/>
      <inertia ixx="0.00061" ixy="0" ixz="0" iyy="0.00112" iyz="0" izz="0.00061"/>
      <origin xyz="0 0 0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.08" length="0.04"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.08" length="0.04"/></geometry>
    </collision>
  </link>
  <joint name="wheel_front_right_joint" type="continuous">
    <parent link="base_link"/><child link="wheel_front_right_link"/>
    <origin xyz="0.12 -0.22 -0.08" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>

  <!-- IMU (no geometry, sensor only) -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- stereo cameras: baseline 0.11 m, forward looking -->
  <link name="cam0_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.04"/></geometry>
      <material name="blue"/>
    </visual>
  </link>
  <joint name="cam0_joint" type="fixed">
    <parent link="base_link"/><child link="cam0_link"/>
    <origin xyz="0.22 0.055 0.12" rpy="0 0 0"/>
  </joint>

  <link name="cam1_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.04"/></geometry>
      <material name="red"/>
    </visual>
  </link>
  <joint name="cam1_joint" type="fixed">
    <parent link="base_link"/><child link="cam1_link"/>
    <origin xyz="0.22 -0.055 0.12" rpy="0 0 0"/>
  </joint>

  <!-- ============ GAZEBO PLUGINS ============ -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <remapping>cmd_vel:=/cmd_vel</remapping>
        <remapping>odom:=/odom</remapping>
      </ros>
      <update_rate>50</update_rate>
      <num_wheel_pairs>2</num_wheel_pairs>
      <left_joint>wheel_front_left_joint</left_joint>
      <left_joint>wheel_rear_left_joint</left_joint>
      <right_joint>wheel_front_right_joint</right_joint>
      <right_joint>wheel_rear_right_joint</right_joint>
      <wheel_separation>0.44</wheel_separation>
      <wheel_separation>0.44</wheel_separation>
      <wheel_diameter>0.16</wheel_diameter>
      <wheel_diameter>0.16</wheel_diameter>
      <max_wheel_torque>1.0</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin name="joint_state" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <remapping>~/out:=/joint_states</remapping>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>wheel_front_left_joint</joint_name>
      <joint_name>wheel_rear_left_joint</joint_name>
      <joint_name>wheel_front_right_joint</joint_name>
      <joint_name>wheel_rear_right_joint</joint_name>
    </plugin>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-04</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-04</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-04</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>2.0e-03</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>2.0e-03</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>2.0e-03</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=/imu0</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="cam0_link">
    <sensor name="cam0_sensor" type="camera">
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <camera name="cam0">
        <horizontal_fov>1.57</horizontal_fov>
        <image><width>640</width><height>400</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>50</far></clip>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.0</stddev></noise>
      </camera>
      <plugin name="cam0_driver" filename="libgazebo_ros_camera.so">
        <camera_name>cam0</camera_name>
        <frame_name>cam0_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="cam1_link">
    <sensor name="cam1_sensor" type="camera">
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <camera name="cam1">
        <horizontal_fov>1.57</horizontal_fov>
        <image><width>640</width><height>400</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>50</far></clip>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.0</stddev></noise>
      </camera>
      <plugin name="cam1_driver" filename="libgazebo_ros_camera.so">
        <camera_name>cam1</camera_name>
        <frame_name>cam1_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="wheel_front_left_link">
    <mu1>1.0</mu1><mu2>1</mu2><kp>1e5</kp><kd>10</kd>
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="wheel_front_right_link">
    <mu1>1.0</mu1><mu2>1</mu2><kp>1e5</kp><kd>10</kd>
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="wheel_rear_left_link">
    <mu1>1.0</mu1><mu2>1</mu2><kp>1e5</kp><kd>10</kd>
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="wheel_rear_right_link">
    <mu1>1.0</mu1><mu2>1</mu2><kp>1e5</kp><kd>10</kd>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
</robot>
